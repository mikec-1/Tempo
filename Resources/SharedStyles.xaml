<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#121212" />
    <SolidColorBrush x:Key="PanelBrush" Color="#181818" />
    <SolidColorBrush x:Key="HoverBrush" Color="#282828" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1ED760" />

    <!-- Fonts -->
    <FontFamily x:Key="MainFont">Segoe UI</FontFamily>

    <!-- Corner radius -->
    <CornerRadius x:Key="CornerRadius">8px</CornerRadius>

    <!-- Base style for controls -->
    <Style TargetType="{x:Type Control}">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ScrollBar: thumb and track resources (defined above the style that uses them) -->
    <ControlTemplate x:Key="ScrollBarThumbVerticalTemplate" TargetType="{x:Type Thumb}">
        <Border x:Name="thumbBorder" Background="#5A5A5A" CornerRadius="4" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="thumbBorder" Property="Background" Value="#8A8A8A" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollBarThumbHorizontalTemplate" TargetType="{x:Type Thumb}">
        <Border x:Name="thumbBorder" Background="#5A5A5A" CornerRadius="4" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="thumbBorder" Property="Background" Value="#8A8A8A" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ScrollBarTrackRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical ScrollBar template -->
    <ControlTemplate x:Key="ScrollBarVerticalTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Track x:Name="PART_Track" Grid.Row="0" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarTrackRepeatButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarTrackRepeatButtonStyle}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Template="{StaticResource ScrollBarThumbVerticalTemplate}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Horizontal ScrollBar template -->
    <ControlTemplate x:Key="ScrollBarHorizontalTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Track x:Name="PART_Track" Grid.Column="0">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarTrackRepeatButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarTrackRepeatButtonStyle}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Template="{StaticResource ScrollBarThumbHorizontalTemplate}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Implicit ScrollBar style (no x:Key) -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Template" Value="{StaticResource ScrollBarVerticalTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template" Value="{StaticResource ScrollBarHorizontalTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Converter: null → Visible, non-null → Collapsed -->
    <BooleanToVisibilityConverter x:Key="ReverseBoolToVisConverter" />

    <!-- Navigation arrow geometries -->
    <Geometry x:Key="BackArrowGeometry">M15.41 16.09L10.83 11.5L15.41 6.91L14 5.5L8 11.5L14 17.5L15.41 16.09Z</Geometry>
    <Geometry x:Key="ForwardArrowGeometry">M8.59 16.59L13.17 12L8.59 7.41L10 6L16 12L10 18L8.59 16.59Z</Geometry>
    <Geometry x:Key="SearchGeometry">M15.5 14h-1.7l-.5-.5A5.5 5.5 0 0 0 21 8.5a5.5 5.5 0 1 0-6.5 5.3v1.7l.5.5h1.7l4.8 4.8 1.2-1.2-4.8-4.8zM8.5 13a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z</Geometry>

    <!-- Round navigation button style -->
    <Style x:Key="RoundNavButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="16" x:Name="_border">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="_border" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Profile button style -->
    <Style x:Key="ProfileButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="16">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tempo logo: musical note -->
    <Geometry x:Key="TempoLogoGeometry">M12 2C10.34 2 9 3.34 9 5c0 .81.2 1.57.55 2.22L7 10H5v6h2l2-2h2l2 2h2v-6h-2l-2.55-2.78C10.8 11.43 10.41 12 10 13c0-1.66 1.34-3 3-3s3 1.34 3 3h2c0-2.76-2.24-5-5-5z</Geometry>

</ResourceDictionary>
