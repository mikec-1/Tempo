<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#121212" />
    <SolidColorBrush x:Key="PanelBrush" Color="#181818" />
    <SolidColorBrush x:Key="HoverBrush" Color="#282828" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1ED760" />

    <!-- Fonts -->
    <FontFamily x:Key="MainFont">Segoe UI</FontFamily>

    <!-- Corner radius -->
    <CornerRadius x:Key="CornerRadius">8px</CornerRadius>

    <!-- Base style for controls -->
    <Style TargetType="{x:Type Control}">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ScrollBar: thumb and track resources (defined above the style that uses them) -->
    <ControlTemplate x:Key="ScrollBarThumbVerticalTemplate" TargetType="{x:Type Thumb}">
        <Border x:Name="thumbBorder" Background="#5A5A5A" CornerRadius="4" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="thumbBorder" Property="Background" Value="#8A8A8A" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollBarThumbHorizontalTemplate" TargetType="{x:Type Thumb}">
        <Border x:Name="thumbBorder" Background="#5A5A5A" CornerRadius="4" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="thumbBorder" Property="Background" Value="#8A8A8A" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ScrollBarTrackRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical ScrollBar template -->
    <ControlTemplate x:Key="ScrollBarVerticalTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Track x:Name="PART_Track" Grid.Row="0" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarTrackRepeatButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarTrackRepeatButtonStyle}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Template="{StaticResource ScrollBarThumbVerticalTemplate}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Horizontal ScrollBar template -->
    <ControlTemplate x:Key="ScrollBarHorizontalTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Track x:Name="PART_Track" Grid.Column="0">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarTrackRepeatButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarTrackRepeatButtonStyle}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Template="{StaticResource ScrollBarThumbHorizontalTemplate}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Implicit ScrollBar style (no x:Key) -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Template" Value="{StaticResource ScrollBarVerticalTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template" Value="{StaticResource ScrollBarHorizontalTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Converter: null → Visible, non-null → Collapsed -->
    <BooleanToVisibilityConverter x:Key="ReverseBoolToVisConverter" />

    <!-- Back arrow geometry (left-pointing) -->
    <Geometry x:Key="BackArrowGeometry">M15.41 16.09L10.83 11.5L15.41 6.91L14 5.5L8 11.5L14 17.5L15.41 16.09Z</Geometry>

    <!-- NullToVisibilityConverter -->
    <Style x:Key="NullToVisibleStyle" TargetType="{x:Type UIElement}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentPlaylist}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
