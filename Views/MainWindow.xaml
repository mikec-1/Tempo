<Window x:Class="Tempo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Tempo.Views"
        Title="Tempo"
        Width="1200" Height="750"
        MinWidth="1000" MinHeight="650"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="90" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <views:Sidebar Grid.Column="0" DataContext="{Binding Sidebar}" />

            <!-- Main Content -->
            <views:HomeView Grid.Column="1" DataContext="{Binding HomeContent}" Margin="16,0,0,0" />
        </Grid>

        <!-- Player Bar -->
        <views:PlayerBar Grid.Row="1" DataContext="{Binding PlayerBar}" />
    </Grid>
</Window>
