<Window x:Class="Tempo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Tempo.Views"
        Title="Tempo"
        Width="1200" Height="750"
        MinWidth="1000" MinHeight="650"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <views:Sidebar Grid.Column="0" DataContext="{Binding Sidebar}" />

        <!-- Main Content Placeholder -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" Margin="16,0,0,0" CornerRadius="8">
            <TextBlock Text="Main content area" Foreground="{StaticResource SecondaryTextBrush}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
