<Window x:Class="Tempo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Tempo.Views"
        Title="Tempo"
        Width="1200" Height="750"
        MinWidth="1000" MinHeight="650"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="90" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <views:Sidebar Grid.Column="0" DataContext="{Binding Sidebar}" />

            <!-- Main Content Area -->
            <Border Grid.Column="1" Margin="16,0,0,0">
                <Grid>
                    <!-- Back button bar (visible when viewing a playlist) -->
                    <StackPanel Orientation="Horizontal" 
                                VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPlaylist}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Width="32" Height="32" 
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding GoBackCommand}" Margin="8,0,0,0" Cursor="Hand">
                            <Path Data="{StaticResource BackArrowGeometry}" Fill="{StaticResource PrimaryTextBrush}" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </StackPanel>

                    <!-- Content switcher -->
                    <ContentControl Margin="0,48,0,0">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <!-- Default: Show PlaylistView when a playlist is selected -->
                                <Setter Property="Content" Value="{Binding CurrentPlaylist}" />
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:PlaylistView DataContext="{Binding}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- Override: Show HomeView when no playlist selected -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPlaylist}" Value="{x:Null}">
                                        <Setter Property="Content" Value="{Binding HomeContent}" />
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <views:HomeView DataContext="{Binding}" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Player Bar -->
        <views:PlayerBar Grid.Row="1" DataContext="{Binding PlayerBar}" />
    </Grid>
</Window>
