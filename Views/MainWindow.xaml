<Window x:Class="Tempo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Tempo.Views"
        Title="Tempo"
        Width="1200" Height="750"
        MinWidth="1000" MinHeight="650"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="90" />
        </Grid.RowDefinitions>

        <!-- Custom dark title bar -->
        <Border Grid.Row="0" Background="#121212">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Logo + Title -->
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16" Margin="0,0,8,0">
                        <Path Data="{StaticResource TempoLogoGeometry}" Fill="#FFFFFF" Stretch="Uniform" />
                    </Canvas>
                    <TextBlock Text="Tempo" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="OnMinimizeClick"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#FFFFFF" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="OnMaximizeClick"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#FFFFFF" />
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Click="OnCloseClick"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="CloseIcon" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#FFFFFF" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <views:Sidebar Grid.Column="0" DataContext="{Binding Sidebar}" />

            <!-- Main Content Area -->
            <Border Grid.Column="1" Margin="16,0,0,0">
<Grid>
                    <!-- Top bar -->
                    <Grid VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Back + Forward buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding GoBackCommand}" Margin="8,0,0,0" Style="{StaticResource RoundNavButtonStyle}">
                                <Path Data="{StaticResource BackArrowGeometry}" Fill="{StaticResource PrimaryTextBrush}" Stretch="Uniform" Width="16" Height="16" />
                            </Button>
                            <Button IsEnabled="False" Margin="4,0,0,0" Style="{StaticResource RoundNavButtonStyle}">
                                <Path Data="{StaticResource ForwardArrowGeometry}" Fill="{StaticResource PrimaryTextBrush}" Stretch="Uniform" Width="16" Height="16" />
                            </Button>
                        </StackPanel>

                        <!-- Center: Search box -->
                        <TextBox Grid.Column="1" Margin="24,0,0,0" Padding="8,0,30,0"
                                  Height="40" MaxWidth="480" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="#242424" Foreground="{StaticResource PrimaryTextBrush}"
                                  BorderThickness="0" FontSize="13" CaretBrush="White">
                            <TextBox.Template>
                                <ControlTemplate TargetType="{x:Type TextBox}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                        <Grid>
                                            <TextBlock Text="What do you want to play?"
                                                       Foreground="#8A8A8A" FontSize="13"
                                                       Margin="14,0,30,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringEmptyToVisConverter}}" />
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="14,0,30,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>

                        <!-- Right: Profile circle -->
                        <Button Grid.Column="2" Margin="16,0,8,0" Style="{StaticResource ProfileButtonStyle}">
                            <TextBlock Text="M" Foreground="#121212" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- Content switcher -->
                    <ContentControl Margin="0,56,0,0">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <!-- Default: Show PlaylistView when a playlist is selected -->
                                <Setter Property="Content" Value="{Binding CurrentPlaylist}" />
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:PlaylistView DataContext="{Binding}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- Override: Show HomeView when no playlist selected -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPlaylist}" Value="{x:Null}">
                                        <Setter Property="Content" Value="{Binding HomeContent}" />
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <views:HomeView DataContext="{Binding}" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Player Bar -->
        <views:PlayerBar Grid.Row="2" DataContext="{Binding PlayerBar}" />
    </Grid>
</Window>
