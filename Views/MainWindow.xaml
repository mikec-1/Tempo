<Window x:Class="Tempo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Tempo.Views"
        Title="Tempo"
        Width="1200" Height="750"
        MinWidth="1000" MinHeight="650"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="90" />
        </Grid.RowDefinitions>

        <!-- Custom dark title bar -->
        <Border Grid.Row="0" Background="#121212">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Logo + Title -->
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16" Margin="0,0,8,0">
                        <Path Data="{StaticResource TempoLogoGeometry}" Fill="#FFFFFF" Stretch="Uniform" />
                    </Canvas>
                    <TextBlock Text="Tempo" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="46" Height="32" Background="Transparent" BorderThickness="0"
                            Click="OnMinimizeClick" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource MinimizeGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" />
                    </Button>
                    <Button Width="46" Height="32" Background="Transparent" BorderThickness="0"
                            Click="OnMaximizeClick" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="MaximizeIcon" Data="{StaticResource MaximizeGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" />
                    </Button>
                    <Button Background="Transparent" BorderThickness="0"
                            Click="OnCloseClick" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Width" Value="46" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" x:Name="CloseButtonBorder">
                                                <Path Data="{StaticResource CloseGeometry}" Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10">
                                                    <Path.Style>
                                                        <Style TargetType="{x:Type Path}">
                                                            <Setter Property="Margin" Value="0,2,0,0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                    <Setter Property="Fill" Value="#E81123" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter TargetName="CloseButtonBorder" Property="Background" Value="#E81123" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Title bar drag area (transparent, covers entire row) -->
                <Border Grid.ColumnSpan="3" Background="Transparent" IsHitTestVisible="True" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <views:Sidebar Grid.Column="0" DataContext="{Binding Sidebar}" />

            <!-- Main Content Area -->
            <Border Grid.Column="1" Margin="16,0,0,0">
<Grid>
                    <!-- Back button bar -->
                    <StackPanel Orientation="Horizontal" 
                                VerticalAlignment="Top">
                        <Button Width="32" Height="32" 
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding GoBackCommand}" Margin="8,0,0,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="Transparent" CornerRadius="16" x:Name="_border">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="_border" Property="Background" Value="{StaticResource HoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Path Data="{StaticResource BackArrowGeometry}" Fill="{StaticResource PrimaryTextBrush}" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </StackPanel>

                    <!-- Content switcher -->
                    <ContentControl Margin="0,48,0,0">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <!-- Default: Show PlaylistView when a playlist is selected -->
                                <Setter Property="Content" Value="{Binding CurrentPlaylist}" />
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:PlaylistView DataContext="{Binding}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- Override: Show HomeView when no playlist selected -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPlaylist}" Value="{x:Null}">
                                        <Setter Property="Content" Value="{Binding HomeContent}" />
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <views:HomeView DataContext="{Binding}" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Player Bar -->
        <views:PlayerBar Grid.Row="2" DataContext="{Binding PlayerBar}" />
    </Grid>
</Window>
