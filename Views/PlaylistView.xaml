<UserControl x:Class="Tempo.Views.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Tempo.Models">
    <UserControl.Resources>

        <!-- Play icon -->
        <Geometry x:Key="PlayIconGeometry">M8 5V19L19 12L8 5Z</Geometry>

        <!-- Track row style -->
        <Style x:Key="TrackRowStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Padding" Value="0,6,0,6" />
            <Setter Property="Margin" Value="0,0,48,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#282828" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3E3E3E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Track item template -->
        <DataTemplate x:Key="TrackItemTemplate" DataType="{x:Type models:TrackModel}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <!-- Number / Play button -->
                <Grid Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="NumText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center" />
                    <Path x:Name="PlayIcon" Data="{StaticResource PlayIconGeometry}" Fill="{StaticResource AccentBrush}" 
                          Stretch="Uniform" Width="14" Height="14" Opacity="0"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>

                <!-- Title / Artist -->
                <Grid Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Artist}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" 
                               VerticalAlignment="Bottom" Margin="0,0,0,1" />
                </Grid>

                <!-- Album -->
                <TextBlock Grid.Column="2" Text="{Binding Album}" 
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" 
                           VerticalAlignment="Center" 
                           TextTrimming="CharacterEllipsis" />

                <!-- Date added (mock relative dates from item index) -->
                <TextBlock Grid.Column="3" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" 
                           VerticalAlignment="Center">
                    <Run Text="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=(ItemsControl.AlternationIndex)}" />
                    <Run Text=" days ago" />
                </TextBlock>

                <!-- Duration -->
                <TextBlock Grid.Column="4" Text="{Binding Duration, StringFormat={}{0:mm\\:ss}}" 
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" 
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="NumText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PlayIcon" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Playlist Header -->
                <Border Padding="24,48,24,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Large playlist art -->
                        <Border Grid.Column="0" Width="230" Height="230" 
                                Background="{Binding ThumbnailColor}" CornerRadius="8" />

                        <!-- Playlist info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="24,0,0,0">
                            <TextBlock Text="Playlist" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryTextBrush}" 
                                       FontSize="64" FontWeight="Bold" Margin="0,8,0,12" 
                                       TextWrapping="Wrap" MaxWidth="500" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Owner}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="  " />
                                <TextBlock Text="{Binding SongCount}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                                <TextBlock Text="  " />
                                <TextBlock Text="songs" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tracks header -->
                <Grid Margin="24,8,72,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="Normal" />
                    <TextBlock Grid.Column="1" Text="Title" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="Normal" />
                    <TextBlock Grid.Column="2" Text="Album" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="Normal" />
                    <TextBlock Grid.Column="3" Text="Date Added" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="Normal" />
                    <TextBlock Grid.Column="4" Text="#" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="Normal" />
                </Grid>

                <!-- Divider -->
                <Border Height="1" Background="#282828" Margin="24,0,72,0" />

                <!-- Track list with alternating dates -->
                <ListView ItemsSource="{Binding Tracks}"
                          ItemTemplate="{StaticResource TrackItemTemplate}"
                          ItemContainerStyle="{StaticResource TrackRowStyle}"
                          Background="Transparent"
                          BorderThickness="0"
                          AlternationCount="100"
                          Margin="0,4,0,24">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
