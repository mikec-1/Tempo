<UserControl x:Class="Tempo.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Tempo.Models"
             xmlns:utils="clr-namespace:Tempo.Utils">
    <UserControl.Resources>

        <!-- Play icon geometry -->
        <Geometry x:Key="PlayIconGeometry">M8 5V19L19 12L8 5Z</Geometry>

        <!-- Quick access tile style -->
        <Style x:Key="QuickAccessTileStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="80" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="TileGrid">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{Binding utils:AttachedProperties.ThumbnailColor, RelativeSource={RelativeSource AncestorType=Button}}"
                            CornerRadius="4,0,0,4" />
                                    <TextBlock Grid.Column="1"
                                               Text="{TemplateBinding Content}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Margin="12,0,8,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <!-- Play button overlay -->
                            <Border x:Name="TilePlayBtn"
                                    Width="36" Height="36"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,8,4"
                                    Background="#1ED760"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="6" />
                                </Border.RenderTransform>
                                <Path Data="{StaticResource PlayIconGeometry}" Fill="Black" Stretch="Uniform" Width="16" Height="16">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3E3E3E" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TilePlayBtn"
                                                             Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="TilePlayBtn"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="6" To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TilePlayBtn"
                                                             Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="TilePlayBtn"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="0" To="6" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card item container style -->
        <Style x:Key="CardItemContainerStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- Group header style -->
        <Style x:Key="GroupHeaderTextStyle">
            <Setter Property="Control.Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Control.FontFamily" Value="{StaticResource MainFont}" />
            <Setter Property="Control.FontSize" Value="22" />
            <Setter Property="Control.FontWeight" Value="Bold" />
            <Setter Property="Control.Margin" Value="0,24,0,16" />
        </Style>

        <!-- Minimal card button style -->
        <Style x:Key="MinimalCardButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Music card template with hover -->
        <DataTemplate x:Key="MusicCardTemplate" DataType="{x:Type models:MusicCard}">
            <Button Style="{StaticResource MinimalCardButtonStyle}"
                    Background="#181818"
                    Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Title}">
                <Border x:Name="CardBorder" Width="180" Height="250" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Art area with play button overlay -->
                        <Grid x:Name="ArtGrid" Grid.Row="0" Height="140" Margin="0,0,0,12">
                            <Border Background="{Binding ArtColor}" CornerRadius="4" />
                            <Border x:Name="CardPlayBtn"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Width="48" Height="48"
                                    Margin="0,0,6,6"
                                    Background="#1ED760"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="6" />
                                </Border.RenderTransform>
                                <Path Data="{StaticResource PlayIconGeometry}" Fill="Black" Stretch="Uniform" Width="22" Height="22">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                        </Grid>

                        <!-- Title -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Title}"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />

                        <!-- Description -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding Description}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Height="36" />
                    </Grid>
                  </Border>
            </Button>

                  <!-- Card hover + play button -->
                 <DataTemplate.Triggers>
                    <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                        <Setter TargetName="CardBorder" Property="Background" Value="#282828" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CardPlayBtn"
                                                     Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="CardPlayBtn"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="6" To="0" Duration="0:0:0.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CardPlayBtn"
                                                     Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="CardPlayBtn"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="6" Duration="0:0:0.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">

            <!-- Good evening section -->
            <TextBlock Text="Good evening"
                       Style="{StaticResource GroupHeaderTextStyle}"
                       FontSize="28"
                       Margin="0,8,0,12" />

            <ItemsControl ItemsSource="{Binding QuickAccessItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:QuickAccessItem}">
                        <Button Style="{StaticResource QuickAccessTileStyle}"
                                Content="{Binding Title}"
                                Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Title}"
                                utils:AttachedProperties.ThumbnailColor="{Binding ThumbnailColor}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Card groups -->
            <ItemsControl ItemsSource="{Binding CardGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CardGroup}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding GroupTitle}" Style="{StaticResource GroupHeaderTextStyle}" />

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Padding="0"
                                           utils:ScrollHelper.BubbleMouseWheel="True">
                                <ItemsControl ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:MusicCard}">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MusicCardTemplate}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
