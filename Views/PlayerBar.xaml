<UserControl x:Class="Tempo.Views.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Icons -->
        <Geometry x:Key="ShuffleIcon">M17 17H15.59L14.38 10.24C15.81 9.85 16.83 8.74 17.14 7.3H19.49C19.09 9.24 17.76 10.76 16.04 11.45L17.64 20H17ZM13.98 21L12.96 15.58L8.86 11.48C8.37 11.97 7.76 12.34 7.08 12.56L8.28 17H6.5L4.38 5H6.12L7.95 13.1C8.53 12.67 9.19 12.34 9.9 12.13L8.34 3H9.9L10.86 8.04C11.38 7.88 11.93 7.78 12.5 7.78C14.76 7.78 16.58 9.59 16.58 11.85C16.58 14.11 14.76 15.92 12.5 15.92C12.09 15.92 11.7 15.87 11.33 15.78L13.98 21ZM3.56 4L4.77 10.47C3.18 9.9 2 8.49 2 6.73C2 4.97 3.18 3.56 4.77 3L3.56 4Z</Geometry>
        <Geometry x:Key="PreviousIcon">M6 6H8V18H6V6ZM9.5 12L18 6V18L9.5 12Z</Geometry>
        <Geometry x:Key="PlayIcon">M8 5V19L19 12L8 5Z</Geometry>
        <Geometry x:Key="PauseIcon">M14 19H18V5H14V19ZM6 19H10V5H6V19Z</Geometry>
        <Geometry x:Key="NextIcon">M6 18L14.5 12L6 6V18ZM16 6V18H18V6H16Z</Geometry>
        <Geometry x:Key="RepeatIcon">M7 7H17V9H13L17 13L13 17H17V19H7V17H11L7 13L11 9H7V7Z</Geometry>
        <Geometry x:Key="HeartIcon">M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z</Geometry>
        <Geometry x:Key="VolumeIcon">M7 9V15H11L16 20V4L11 9H7Z</Geometry>
        <Geometry x:Key="QueueIcon">M3 13H2V11H3V13ZM3 7H2V5H3V7ZM3 19H2V17H3V19ZM5 5V7H18V5H5ZM5 11V13H18V11H5ZM5 17V19H18V17H5Z</Geometry>
        <Geometry x:Key="DevicesIcon">M20 3H4C2.9 3 2 3.9 2 5V19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V5C22 3.9 21.1 3 20 3ZM20 17H4V11H20V17ZM20 9H4V5H20V9Z</Geometry>
        <Geometry x:Key="QueueListIcon">M3 13H2V11H3V13ZM3 7H2V5H3V7ZM3 19H2V17H3V19ZM4 4H16V6H4V4ZM4 8H16V10H4V8ZM4 12H16V14H4V12ZM4 16H16V18H4V16ZM20 14L17.5 14L16.2 9.8L13.6 17H15.1L16.1 14H20V14Z</Geometry>

        <SolidColorBrush x:Key="PlayerBarBackgroundBrush" Color="#181818" />
        <SolidColorBrush x:Key="PlayerBarButtonHoverBrush" Color="#282828" />
        <SolidColorBrush x:Key="PlayerBarTextBrush" Color="#B3B3B3" />
        <SolidColorBrush x:Key="PlayerBarProgressBackgroundBrush" Color="#4D4D4D" />
        <SolidColorBrush x:Key="PlayerBarProgressForegroundBrush" Color="#FFFFFF" />

        <!-- Shared slider repeat button templates -->
        <ControlTemplate x:Key="SliderRepeatButtonTemplate" TargetType="{x:Type RepeatButton}">
            <Border Background="#FFFFFF" Height="4" CornerRadius="2" />
        </ControlTemplate>

        <ControlTemplate x:Key="SliderIncreaseRepeatButtonTemplate" TargetType="{x:Type RepeatButton}">
            <Border Background="{StaticResource PlayerBarProgressBackgroundBrush}" Height="4" CornerRadius="2" />
        </ControlTemplate>

        <!-- Control button style -->
        <Style x:Key="ControlButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PlayerBarTextBrush}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PlayerBarButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play/Pause button style -->
        <Style x:Key="PlayPauseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#121212" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E0E0E0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Heart button style -->
        <Style x:Key="HeartButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PlayerBarTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#282828" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar-style small icon button -->
        <Style x:Key="PlayerIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PlayerBarTextBrush}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#282828" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Volume slider style -->
        <Style x:Key="VolumeSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Value" Value="70" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid>
                            <Border x:Name="HoverBar" Background="{StaticResource PlayerBarProgressBackgroundBrush}" Height="4" CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" Template="{StaticResource SliderRepeatButtonTemplate}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" Template="{StaticResource SliderIncreaseRepeatButtonTemplate}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Style>
                                            <Style TargetType="{x:Type Thumb}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Ellipse Fill="#FFFFFF" Width="12" Height="12" Opacity="0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="{x:Type Ellipse}">
                                                                        <Setter Property="Opacity" Value="0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress bar style -->
        <Style x:Key="ProgressBarStyle" TargetType="{x:Type Slider}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Value" Value="35" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid>
                            <Border x:Name="HoverBar" Background="{StaticResource PlayerBarProgressBackgroundBrush}" Height="4" CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" Template="{StaticResource SliderRepeatButtonTemplate}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" Template="{StaticResource SliderIncreaseRepeatButtonTemplate}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Style>
                                            <Style TargetType="{x:Type Thumb}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Ellipse Fill="#FFFFFF" Width="12" Height="12" Opacity="0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="{x:Type Ellipse}">
                                                                        <Setter Property="Opacity" Value="0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hover bar green style -->
        <Style x:Key="HoverBarGreenStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PlayerBarProgressBackgroundBrush}" />
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                    <Setter Property="Background" Value="#1ED760" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Track info text style -->
        <Style x:Key="TrackTitleStyle">
            <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="TextElement.FontFamily" Value="{StaticResource MainFont}" />
            <Setter Property="TextElement.FontSize" Value="13" />
        </Style>

        <Style x:Key="TrackArtistStyle">
            <Setter Property="TextElement.Foreground" Value="{StaticResource PlayerBarTextBrush}" />
            <Setter Property="TextElement.FontFamily" Value="{StaticResource MainFont}" />
            <Setter Property="TextElement.FontSize" Value="11" />
        </Style>

        <!-- Thumbnail brush -->
        <SolidColorBrush x:Key="TrackThumbnailBrush" Color="#9C27B0" />
    </UserControl.Resources>

    <Grid Background="{StaticResource PlayerBarBackgroundBrush}" Height="90">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <!-- Left: Track Info -->
        <Grid Grid.Column="0" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="48" Height="48" Background="{StaticResource TrackThumbnailBrush}" CornerRadius="4" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding TrackTitle}" Style="{StaticResource TrackTitleStyle}" />
                <TextBlock Text="{Binding Artist}" Style="{StaticResource TrackArtistStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource HeartButtonStyle}" Margin="-8,0,0,0">
                <TextBlock Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#B3B3B3" />
            </Button>
        </Grid>

        <!-- Center: Playback Controls -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <!-- Control Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Button Background="Transparent" Foreground="#B3B3B3" Width="32" Height="32" Margin="0,0,4,0">
                <TextBlock Text="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>
                <Button Style="{StaticResource ControlButtonStyle}" Margin="0,0,8,0">
                    <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <Button Style="{StaticResource PlayPauseButtonStyle}" Margin="0,0,8,0" Command="{Binding PlayPauseCommand}">
                    <TextBlock x:Name="PlayPauseIcon" Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#121212">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Text" Value="&#xE769;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Text" Value="&#xE768;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource ControlButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ControlButtonStyle}">
                    <TextBlock Text="&#xE8EE;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
            </StackPanel>

            <!-- Progress Bar -->
            <Grid Margin="-40,0,-40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="1:24" Foreground="#B3B3B3" FontSize="11" VerticalAlignment="Center" Margin="8,0,8,0" />
                <Slider Grid.Column="1" Style="{StaticResource ProgressBarStyle}" Margin="8,0" Value="{Binding Progress, Mode=TwoWay}" />
                <TextBlock Text="3:45" Foreground="#B3B3B3" FontSize="11" VerticalAlignment="Center" Margin="8,0,8,0" Grid.Column="2" />
            </Grid>
        </StackPanel>

        <!-- Right: Volume & Queue -->
        <Grid Grid.Column="2" HorizontalAlignment="Right" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Queue Button -->
            <Button Grid.Column="0" Style="{StaticResource PlayerIconButtonStyle}" Margin="0,0,4,0">
                <TextBlock Text="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>

            <!-- Devices Button -->
            <Button Grid.Column="1" Style="{StaticResource PlayerIconButtonStyle}" Margin="0,0,12,0">
                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>

            <!-- Volume Icon -->
            <TextBlock Grid.Column="2" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="#B3B3B3" FontSize="16" Margin="-8,0,8,0" VerticalAlignment="Center" />

            <!-- Volume Slider -->
            <Slider Grid.Column="3" Style="{StaticResource VolumeSliderStyle}" Margin="0,0,12,0" Value="{Binding Volume, Mode=TwoWay}" />

            <!-- Mini Volume Icon (alternative) -->
            <TextBlock Grid.Column="4" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="#B3B3B3" FontSize="16" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
