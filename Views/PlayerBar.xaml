<UserControl x:Class="Tempo.Views.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PlayerBarBackgroundBrush" Color="#181818" />
        <SolidColorBrush x:Key="PlayerBarButtonHoverBrush" Color="#282828" />
        <SolidColorBrush x:Key="PlayerBarTextBrush" Color="#B3B3B3" />
        <SolidColorBrush x:Key="PlayerBarProgressBackgroundBrush" Color="#4D4D4D" />
        <SolidColorBrush x:Key="PlayerBarProgressForegroundBrush" Color="#FFFFFF" />

        <!-- Shared slider repeat button templates -->
        <ControlTemplate x:Key="SliderRepeatButtonTemplate" TargetType="{x:Type RepeatButton}">
            <Border Background="#FFFFFF" Height="4" CornerRadius="2" />
        </ControlTemplate>

        <ControlTemplate x:Key="SliderIncreaseRepeatButtonTemplate" TargetType="{x:Type RepeatButton}">
            <Border Background="{StaticResource PlayerBarProgressBackgroundBrush}" Height="4" CornerRadius="2" />
        </ControlTemplate>

        <!-- Control button style -->
        <Style x:Key="ControlButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PlayerBarTextBrush}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PlayerBarButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play/Pause button style -->
        <Style x:Key="PlayPauseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#121212" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E0E0E0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Heart button style -->
        <Style x:Key="HeartButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PlayerBarTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#282828" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar-style small icon button -->
        <Style x:Key="PlayerIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PlayerBarTextBrush}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#282828" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Volume slider style -->
        <Style x:Key="VolumeSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Value" Value="70" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid>
                            <Border x:Name="HoverBar" Background="{StaticResource PlayerBarProgressBackgroundBrush}" Height="4" CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" Template="{StaticResource SliderRepeatButtonTemplate}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" Template="{StaticResource SliderIncreaseRepeatButtonTemplate}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Style>
                                            <Style TargetType="{x:Type Thumb}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Ellipse Fill="#FFFFFF" Width="12" Height="12" Opacity="0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="{x:Type Ellipse}">
                                                                        <Setter Property="Opacity" Value="0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress bar style -->
        <Style x:Key="ProgressBarStyle" TargetType="{x:Type Slider}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Value" Value="35" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid>
                            <Border x:Name="HoverBar" Background="{StaticResource PlayerBarProgressBackgroundBrush}" Height="4" CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" Template="{StaticResource SliderRepeatButtonTemplate}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" Template="{StaticResource SliderIncreaseRepeatButtonTemplate}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Style>
                                            <Style TargetType="{x:Type Thumb}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Ellipse Fill="#FFFFFF" Width="12" Height="12" Opacity="0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="{x:Type Ellipse}">
                                                                        <Setter Property="Opacity" Value="0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hover bar green style -->
        <Style x:Key="HoverBarGreenStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PlayerBarProgressBackgroundBrush}" />
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                    <Setter Property="Background" Value="#1ED760" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Track info text style -->
        <Style x:Key="TrackTitleStyle">
            <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="TextElement.FontFamily" Value="{StaticResource MainFont}" />
            <Setter Property="TextElement.FontSize" Value="13" />
        </Style>

        <Style x:Key="TrackArtistStyle">
            <Setter Property="TextElement.Foreground" Value="{StaticResource PlayerBarTextBrush}" />
            <Setter Property="TextElement.FontFamily" Value="{StaticResource MainFont}" />
            <Setter Property="TextElement.FontSize" Value="11" />
        </Style>

        <!-- Thumbnail brush -->
        <SolidColorBrush x:Key="TrackThumbnailBrush" Color="#9C27B0" />
    </UserControl.Resources>

    <Grid Background="{StaticResource PlayerBarBackgroundBrush}" Height="90">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <!-- Left: Track Info -->
        <Grid Grid.Column="0" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="48" Height="48" Background="{StaticResource TrackThumbnailBrush}" CornerRadius="4" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding TrackTitle}" Style="{StaticResource TrackTitleStyle}" />
                <TextBlock Text="{Binding Artist}" Style="{StaticResource TrackArtistStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource HeartButtonStyle}" Margin="-8,0,0,0">
                <TextBlock Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#B3B3B3" />
            </Button>
        </Grid>

        <!-- Center: Playback Controls -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <!-- Control Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Button Style="{StaticResource ControlButtonStyle}" Margin="0,0,4,0">
                <TextBlock Text="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>
                <Button Style="{StaticResource ControlButtonStyle}" Margin="0,0,8,0">
                    <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <Button Style="{StaticResource PlayPauseButtonStyle}" Margin="0,0,8,0" Command="{Binding PlayPauseCommand}">
                    <TextBlock x:Name="PlayPauseIcon" Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#121212">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Text" Value="&#xE769;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Text" Value="&#xE768;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource ControlButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ControlButtonStyle}">
                    <TextBlock Text="&#xE8EE;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
            </StackPanel>

            <!-- Progress Bar -->
            <Grid Margin="-40,0,-40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="1:24" Foreground="#B3B3B3" FontSize="11" VerticalAlignment="Center" Margin="8,0,8,0" />
                <Slider Grid.Column="1" Style="{StaticResource ProgressBarStyle}" Margin="8,0" Value="{Binding Progress, Mode=TwoWay}" />
                <TextBlock Text="3:45" Foreground="#B3B3B3" FontSize="11" VerticalAlignment="Center" Margin="8,0,8,0" Grid.Column="2" />
            </Grid>
        </StackPanel>

        <!-- Right: Volume & Queue -->
        <Grid Grid.Column="2" HorizontalAlignment="Right" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Queue Button -->
            <Button Grid.Column="0" Style="{StaticResource PlayerIconButtonStyle}" Margin="0,0,4,0">
                <TextBlock Text="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>

            <!-- Devices Button -->
            <Button Grid.Column="1" Style="{StaticResource PlayerIconButtonStyle}" Margin="0,0,12,0">
                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>

            <!-- Volume Icon -->
            <TextBlock Grid.Column="2" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="#B3B3B3" FontSize="16" Margin="-8,0,8,0" VerticalAlignment="Center" />

            <!-- Volume Slider -->
            <Slider Grid.Column="3" Style="{StaticResource VolumeSliderStyle}" Margin="0,0,12,0" Value="{Binding Volume, Mode=TwoWay}" />
        </Grid>
    </Grid>
</UserControl>
