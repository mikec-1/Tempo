<UserControl x:Class="Tempo.Views.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Tempo.Models">
    <UserControl.Resources>
        <!-- Home Icon -->
        <Geometry x:Key="HomeIconGeometry">M10 20V14H14V20H19V12H22L12 3L2 12H5V20H10Z</Geometry>

        <!-- Search Icon -->
        <Geometry x:Key="SearchIconGeometry">M15.5 14H14.71L14.43 13.73C15.41 12.59 16 11.11 16 9.5C16 5.91 13.09 3 9.5 3S3 5.91 3 9.5C3 13.09 5.91 16 9.5 16C11.11 16 12.59 15.41 13.73 14.43L14 14.71V15.5L19 20.49C19.4 20.89 20.1 20.89 20.5 20.49C20.9 20.1 20.9 19.4 20.5 19L15.5 14ZM9.5 14C7.01 14 5 11.99 5 9.5C5 7.01 7.01 5 9.5 5C11.99 5 14 7.01 14 9.5C14 11.99 11.99 14 9.5 14Z</Geometry>

        <!-- Plus Icon -->
        <Geometry x:Key="PlusIconGeometry">M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>

        <SolidColorBrush x:Key="SidebarNavHoverBrush" Color="#282828" />
        <SolidColorBrush x:Key="SidebarNavItemTextBrush" Color="#B3B3B3" />

        <Style x:Key="SidebarNavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="16,8,16,0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SidebarNavItemTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SidebarNavHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3E3E3E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaylistItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#282828" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PlaylistItemTemplate" DataType="{x:Type models:PlaylistModel}">
            <Grid Margin="4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" Background="{Binding ThumbnailColor}" CornerRadius="4" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="Normal" />
                    <TextBlock Text="{Binding SongCount, StringFormat={}{0} songs}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="LibraryHeaderTextStyle">
            <Setter Property="Control.Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Control.FontFamily" Value="{StaticResource MainFont}" />
            <Setter Property="Control.FontSize" Value="16" />
            <Setter Property="Control.FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="LibraryPlusButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#282828" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation -->
        <StackPanel Grid.Row="0" Margin="0,16,0,8">
            <Button Style="{StaticResource SidebarNavButtonStyle}" HorizontalContentAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource HomeIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="16" Height="16" />
                    <TextBlock Grid.Column="1" Text="Home" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button Style="{StaticResource SidebarNavButtonStyle}" HorizontalContentAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource SearchIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="16" Height="16" />
                    <TextBlock Grid.Column="1" Text="Search" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>

        <!-- Bottom Library Section -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,8,0,0">
                <!-- Library Header -->
                <Grid Margin="16,8,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Your Library" Style="{StaticResource LibraryHeaderTextStyle}" />
                    <Button Grid.Column="1" Style="{StaticResource LibraryPlusButtonStyle}">
                        <Path Data="{StaticResource PlusIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <!-- Filter Chips -->
                <StackPanel Orientation="Horizontal" Margin="16,0,16,12">
                    <Button Content="Playlists" Style="{StaticResource FilterChipStyle}" Margin="0,0,8,0" />
                    <Button Content="Artists" Style="{StaticResource FilterChipStyle}" Margin="0,0,8,0" />
                    <Button Content="Albums" Style="{StaticResource FilterChipStyle}" />
                </StackPanel>

                <!-- Playlist List -->
                <ListView ItemsSource="{Binding Playlists}"
                          ItemTemplate="{StaticResource PlaylistItemTemplate}"
                          ItemContainerStyle="{StaticResource PlaylistItemStyle}"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
